# Primario — Gemini (OpenAI-compatible)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=90

# Fallback — servidor OpenAI-compatible (solo si Gemini falla 429/404/503)
FALLBACK_ENABLED=false
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_TIMEOUT=180

# Seguridad / red
# Orígenes del front permitidos (coma-separados). Usar * solo en demos locales.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Tamaño máximo de archivo subido (MB)
MAX_UPLOAD_MB=25
